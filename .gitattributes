# Store text with LF; Windows launchers check out with CRLF because cmd.exe
# misparses labels in LF batch files.
* text=auto eol=lf
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# The launcher hashes these to notice a change, so they keep LF whatever git guesses.
*.Modelfile text eol=lf
package.json text eol=lf
package-lock.json text eol=lf

*.ico binary
*.lnk binary
*.gguf binary
*.safetensors binary

# git archive leaves these out of the release zip, which keeps only what the launcher runs and
# its documents. tests\Release.Tests.ps1 checks that every other tracked file is such a file.
/.github/ export-ignore
/.githooks/ export-ignore
/tests/ export-ignore
/.editorconfig export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/PSScriptAnalyzerSettings.psd1 export-ignore
/CONTRIBUTING.md export-ignore
