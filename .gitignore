# Secrets. HF_TOKEN lives in the environment; Open WebUI's signing key and
# database belong to %LOCALAPPDATA%\open-webui, never to this repo.
.env*
!.env.example
.webui_secret_key
webui.db

# Model weights and partial downloads.
*.gguf
*.safetensors
*.part

# Start Menu shortcuts are generated with absolute paths.
*.lnk

# Python bytecode and local environments.
__pycache__/
*.py[cod]
.venv/
.pytest_cache/

# Logs.
*.log

# Editor and OS files.
.vscode/
.idea/
*.swp
*.swo
*~
Thumbs.db
desktop.ini
.DS_Store
